ay.isArray(posts) || !posts.length) return;\n        posts.sort(function(){return Math.random()-0.5;});\n        posts = posts.slice(0,3);\n        var rel = document.createElement('section');\n        rel.className = 'sxa-related';\n        var grid = '';\n        posts.forEach(function(p){\n          var img = '';\n          try{\n            if(p._embedded && p._embedded['wp:featuredmedia'] && p._embedded['wp:featuredmedia'][0]){\n              var media = p._embedded['wp:featuredmedia'][0];\n              if(media.media_details && media.media_details.sizes){\n                var sizes = media.media_details.sizes;\n                img = (sizes.medium_large && sizes.medium_large.source_url) || (sizes.medium && sizes.medium.source_url) || media.source_url || '';\n              } else { img = media.source_url || ''; }\n            }\n          }catch(e){}\n          var cat = '';\n          try{\n            if(p._embedded && p._embedded['wp:term'] && p._embedded['wp:term'][0] && p._embedded['wp:term'][0][0]){\n              cat = p._embedded['wp:term'][0][0].name;\n            }\n          }catch(e){}\n          var d = new Date(p.date);\n          var dateText = d.toLocaleDateString('en-GB',{day:'numeric',month:'short',year:'numeric'});\n          grid += '<a class=\"sxa-rel-card\" href=\"'+p.link+'\">'+\n            '<div class=\"sxa-rel-thumb\" style=\"background-image:url(\\''+img+'\\')\"><span class=\"sxa-rel-pill\">'+(cat||'Portfolio')+'<\/span><\/div>'+\n            '<div class=\"sxa-rel-body\">'+\n              '<span class=\"sxa-rel-meta\">'+dateText+'<\/span>'+\n              '<h3 class=\"sxa-rel-title\">'+p.title.rendered+'<\/h3>'+\n              '<span class=\"sxa-rel-arrow\">Baca Artikel &rarr;<\/span>'+\n            '<\/div>'+\n          '<\/a>';\n        });\n        rel.innerHTML = '<div class=\"sxa-related-head\">'+\n          '<h2 class=\"sxa-related-title\"><small>Continue Reading<\/small>Artikel Lainnya<\/h2>'+\n          '<a class=\"sxa-related-all\" href=\"\/artikel\/\">Lihat Semua &rarr;<\/a>'+\n        '<\/div>'+\n        '<div class=\"sxa-related-grid\">'+grid+'<\/div>';\n        var cta = document.querySelector('.sxa-cta-final');\n        if(cta) cta.parentNode.insertBefore(rel, cta.nextSibling);\n      })\n      .catch(function(){});\n  })();\n  var bt=document.createElement('button');bt.type='button';bt.className='sxa-back-top';bt.setAttribute('aria-label','Back to top');\n  bt.innerHTML='<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><polyline points=\"18 15 12 9 6 15\"><\/polyline><\/svg>';\n  bt.onclick=function(){window.scrollTo({top:0,behavior:'smooth'});};\n  document.body.appendChild(bt);\n  var pb=document.createElement('div');pb.className='sxa-progress';pb.innerHTML='<div class=\"sxa-progress-bar\"><\/div>';document.body.appendChild(pb);\n  var pbar=pb.firstChild;\n  window.addEventListener('scroll',function(){\n    var h=document.documentElement,sc=h.scrollTop||document.body.scrollTop,total=h.scrollHeight-h.clientHeight;\n    pbar.style.width=(total>0?sc\/total*100:0)+'%';\n    bt.classList.toggle('show',sc>600);\n  },{passive:true});\n}\nif(document.readyState==='loading')document.addEventListener('DOMContentLoaded',init);else init();\n})();\n<\/script>\n"},"_links":{"self":[{"href":"https:\/\/suriota.com\/wp-json\/wp\/v2\/elementor_snippet\/5184","targetHints":{"allow":["GET","POST","PUT","PATCH","DELETE"]}}],"collection":[{"href":"https:\/\/suriota.com\/wp-json\/wp\/v2\/elementor_snippet"}],"about":[{"href":"https:\/\/suriota.com\/wp-json\/wp\/v2\/types\/elementor_snippet"}],"author":[{"embeddable":true,"href":"https:\/\/suriota.com\/wp-json\/wp\/v2\/users\/1"}],"wp:attachment":[{"href":"https:\/\/suriota.com\/wp-json\/wp\/v2\/media?parent=5184"}],"wp:action-publish":[{"href":"https:\/\/suriota.com\/wp-json\/wp\/v2\/elementor_snippet\/5184"}],"wp:action-unfiltered-html":[{"href":"https:\/\/suriota