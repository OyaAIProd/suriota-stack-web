"[{\"id\":\"e4d0856\",\"elType\":\"section\",\"settings\":{\"animation\":\"fadeIn\"},\"elements\":[{\"id\":\"c48a432\",\"elType\":\"column\",\"settings\":{\"_column_size\":100,\"_inline_size\":null},\"elements\":[{\"id\":\"d0e6bbb\",\"elType\":\"widget\",\"settings\":{\"html\":\"<div class=\\\"sx-hero-meta\\\"><span class=\\\"sx-hero-eyebrow\\\">Smart Prepaid Energy Meter</span><span class=\\\"sx-hero-sku\\\">SKU: PM1611-WD</span></div>\"},\"elements\":[],\"widgetType\":\"html\"},{\"id\":\"5bccd9c\",\"elType\":\"widget\",\"settings\":{\"title\":\"PM1611-WD\",\"header_size\":\"h1\",\"title_color\":\"#3C7D47\",\"_padding\":{\"unit\":\"px\",\"top\":\"15\",\"right\":\"15\",\"bottom\":\"15\",\"left\":\"15\",\"isLinked\":true},\"align\":\"center\"},\"elements\":[],\"widgetType\":\"heading\"}],\"isInner\":false}],\"isInner\":false},{\"id\":\"57292b7\",\"elType\":\"section\",\"settings\":[],\"elements\":[{\"id\":\"c39ffa8\",\"elType\":\"column\",\"settings\":{\"_column_size\":100,\"_inline_size\":null},\"elements\":[{\"id\":\"494b0c4\",\"elType\":\"widget\",\"settings\":{\"html\":\"<div class=\\\"sx-section sx-industries sx-prod-apps\\\">\\n  <div class=\\\"sx-industries-inner\\\">\\n    <span class=\\\"sx-eyebrow\\\">Applications</span>\\n    <h2 class=\\\"sx-industries-title\\\">Where PM1611-WD is deployed</h2>\\n    <div class=\\\"sx-chip-row\\\">\\n      <span class=\\\"sx-chip\\\">Apartments</span>\\n      <span class=\\\"sx-chip\\\">Boarding House (Kos)</span>\\n      <span class=\\\"sx-chip\\\">Rental Property</span>\\n      <span class=\\\"sx-chip\\\">Retail Tenants</span>\\n      <span class=\\\"sx-chip\\\">Office Sub-Metering</span>\\n      <span class=\\\"sx-chip\\\">Industrial Sub-Billing</span>\\n      <span class=\\\"sx-chip\\\">Marketplace Stalls</span>\\n      <span class=\\\"sx-chip\\\">Workshop &amp; SOHO</span>\\n    </div>\\n  </div>\\n</div>\"},\"elements\":[],\"widgetType\":\"html\"},{\"id\":\"cfb6020\",\"elType\":\"widget\",\"settings\":{\"title\":\"Smart, Secure, and Efficient Prepaid Energy Management\\n\\n\",\"header_size\":\"div\",\"align\":\"center\",\"__globals__\":{\"typography_typography\":\"globals/typography?id=secondary\",\"title_color\":\"globals/colors?id=accent\"}},\"elements\":[],\"widgetType\":\"heading\"},{\"id\":\"69edade\",\"elType\":\"widget\",\"settings\":{\"image\":{\"url\":\"https://suriota.com/wp-content/uploads/2025/11/energy-meter-iot-poster.webp\",\"id\":1712,\"size\":\"\",\"alt\":\"\",\"source\":\"library\"}},\"elements\":[],\"widgetType\":\"image\"},{\"id\":\"9ad71a7\",\"elType\":\"widget\",\"settings\":{\"editor\":\"<p>Control energy usage, eliminate billing disputes, and improve operational efficiency with the PM1611-WD Prepaid Energy Meter IoT. Designed for rental spaces, kiosks, offices, and machinery, this smart meter combines precision energy measurement with IoT connectivity. Giving you full control anytime, anywhere.</p><p><strong>Take full control of your power consumption.</strong><br/>With the PM1611-WD, you can monitor, manage, and secure energy usage ensuring fair billing, preventing wastage, and optimizing performance.</p>\"},\"elements\":[],\"widgetType\":\"text-editor\"},{\"id\":\"4e7bbb3\",\"elType\":\"widget\",\"settings\":{\"html\":\"<section class=\\\"sx-section sx-whyus sx-prod-features\\\">\\n  <div class=\\\"sx-whyus-inner\\\">\\n    <span class=\\\"sx-eyebrow\\\">KEY FEATURES</span>\\n    <h2 class=\\\"sx-whyus-title\\\">Why landlords &amp; operators choose PM1611-WD</h2>\\n    <div class=\\\"sx-whyus-grid\\\">\\n      <article class=\\\"sx-whyus-card\\\"><div class=\\\"sx-whyus-num\\\">01</div><h3 class=\\\"sx-whyus-h3\\\">Prepaid Token Billing</h3><p class=\\\"sx-whyus-desc\\\"><strong>Token-based credit system</strong> eliminates billing disputes. Tenants top-up; meter auto-disconnects at zero balance.</p></article>\\n      <article class=\\\"sx-whyus-card\\\"><div class=\\\"sx-whyus-num\\\">02</div><h3 class=\\\"sx-whyus-h3\\\">Remote Connect/Disconnect</h3><p class=\\\"sx-whyus-desc\\\">Built-in relay enables <strong>remote service control</strong> via WiFi/4G. No site visit needed for activation or disconnection.</p></article>\\n      <article class=\\\"sx-whyus-card\\\"><div class=\\\"sx-whyus-num\\\">03</div><h3 class=\\\"sx-whyus-h3\\\">Multi-Tariff Configuration</h3><p class=\\\"sx-whyus-desc\\\">Set <strong>peak/off-peak rates, flat tariffs, custom plans</strong>. Auto-calculate based on time-of-use schedules per tenant.</p></article>\\n      <article class=\\\"sx-whyus-card\\\"><div class=\\\"sx-whyus-num\\\">04</div><h3 class=\\\"sx-whyus-h3\\\">LCD + Mobile Alerts</h3><p class=\\\"sx-whyus-desc\\\">Local LCD shows balance and consumption. <strong>WhatsApp/SMS notifications</strong> on low balance, anomalies, and top-ups.</p></article>\\n      <article class=\\\"sx-whyus-card\\\"><div class=\\\"sx-whyus-num\\\">05</div><h3 class=\\\"sx-whyus-h3\\\">Historical Usage Tracking</h3><p class=\\\"sx-whyus-desc\\\">Review up to <strong>6 days of detailed energy usage</strong> per tenant. Identify abnormal consumption and resolve disputes with data.</p></article>\\n      <article class=\\\"sx-whyus-card\\\"><div class=\\\"sx-whyus-num\\\">06</div><h3 class=\\\"sx-whyus-h3\\\">Web Management Portal</h3><p class=\\\"sx-whyus-desc\\\">Configure and monitor remotely via web interface using <strong>Blynk or MQTT</strong> protocol. RTC with NTP sync ensures accurate billing time.</p></article>\\n    </div>\\n  </div>\\n</section>\"},\"elements\":[],\"widgetType\":\"html\"},{\"id\":\"054d361\",\"elType\":\"widget\",\"settings\":{\"html\":\"<div class=\\\"sx-action-group\\\">\\n  <a class=\\\"sx-action-btn sx-action-btn--primary\\\" href=\\\"https://www.tokopedia.com/suriota\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\" aria-label=\\\"Order PM1611-WD on Tokopedia\\\">\\n    <svg width=\\\"18\\\" height=\\\"18\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" aria-hidden=\\\"true\\\"><circle cx=\\\"9\\\" cy=\\\"21\\\" r=\\\"1\\\"/><circle cx=\\\"20\\\" cy=\\\"21\\\" r=\\\"1\\\"/><path d=\\\"M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6\\\"/></svg>\\n    <span>Order on Tokopedia</span>\\n    <span class=\\\"sx-action-arrow\\\">→</span>\\n  </a>\\n  <a class=\\\"sx-action-btn sx-action-btn--secondary\\\" href=\\\"https://drive.google.com/drive/folders/12XOl4YRrcpPVdAbYFFdjo-ylfev5Z-Lu?usp=sharing\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\" aria-label=\\\"Download PM1611-WD datasheet\\\">\\n    <svg width=\\\"18\\\" height=\\\"18\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"none\\\" stroke=\\\"currentColor\\\" stroke-width=\\\"2\\\" stroke-linecap=\\\"round\\\" stroke-linejoin=\\\"round\\\" aria-hidden=\\\"true\\\"><path d=\\\"M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z\\\"/><polyline points=\\\"14 2 14 8 20 8\\\"/><line x1=\\\"12\\\" y1=\\\"18\\\" x2=\\\"12\\\" y2=\\\"12\\\"/><polyline points=\\\"9 15 12 18 15 15\\\"/></svg>\\n    <span>Download Datasheet</span>\\n  </a>\\n</div>\"},\"elements\":[],\"widgetType\":\"html\"},{\"id\":\"98e59c1\",\"elType\":\"widget\",\"settings\":{\"html\":\"<section class=\\\"sx-faq\\\">\\n  <div class=\\\"sx-faq-inner\\\">\\n    <span class=\\\"sx-eyebrow\\\">FAQ</span>\\n    <h2 class=\\\"sx-faq-title\\\">PM1611-WD | Frequently Asked Questions</h2>\\n    <details class=\\\"sx-faq-item\\\"><summary>Does PM1611-WD support remote disconnect?</summary><div class=\\\"sx-faq-answer\\\">Yes. Built-in relay enables remote connect/disconnect via WiFi or 4G cellular. No site visit needed for activation, tenant changeovers, or non-payment disconnections. Service control from your dashboard.</div></details>\\n    <details class=\\\"sx-faq-item\\\"><summary>How does the prepaid token system work?</summary><div class=\\\"sx-faq-answer\\\">Tenants top-up credit via app, e-wallet, or your billing portal. The meter consumes credit based on real-time energy usage and auto-disconnects at zero balance. Low-balance alerts notify before cut-off.</div></details>\\n    <details class=\\\"sx-faq-item\\\"><summary>Can multi-tariff rates be configured?</summary><div class=\\\"sx-faq-answer\\\">Yes. Set peak/off-peak rates, flat tariffs, or custom plans per tenant. Time-of-use schedules automatically apply correct rates. Useful for apartments with different tenant agreements or commercial sub-metering.</div></details>\\n    <details class=\\\"sx-faq-item\\\"><summary>What notification options are available?</summary><div class=\\\"sx-faq-answer\\\">Local LCD displays balance and consumption. WhatsApp, SMS, and email notifications fire on low balance, top-ups, anomalies (over-current, tampering), and scheduled reports.</div></details>\\n  </div>\\n</section>\\n<script type=\\\"application/ld+json\\\">\\n{\\\"@context\\\":\\\"https://schema.org\\\",\\\"@type\\\":\\\"FAQPage\\\",\\\"mainEntity\\\":[\\n{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Does PM1611-WD support remote disconnect?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Yes. Built-in relay via WiFi/4G. Remote service control without site visit for activation or disconnection.\\\"}},\\n{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"How does the prepaid token system work?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Tenants top-up credit via app or portal. Meter consumes credit by usage, auto-disconnects at zero with low-balance alerts.\\\"}},\\n{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"Can multi-tariff rates be configured?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"Yes. Peak/off-peak, flat, custom plans per tenant. Time-of-use schedules apply rates automatically.\\\"}},\\n{\\\"@type\\\":\\\"Question\\\",\\\"name\\\":\\\"What notification options are available?\\\",\\\"acceptedAnswer\\\":{\\\"@type\\\":\\\"Answer\\\",\\\"text\\\":\\\"LCD display + WhatsApp, SMS, email notifications for low balance, top-ups, anomalies, scheduled reports.\\\"}}\\n]}\\n</script>\"},\"elements\":[],\"widgetType\":\"html\"},{\"id\":\"c2a29b1\",\"elType\":\"widget\",\"settings\":{\"html\":\"<section class=\\\"sx-cta-final\\\" aria-labelledby=\\\"prod-cta-heading\\\">\\n  <div class=\\\"sx-cta-final-inner\\\">\\n    <span class=\\\"sx-cta-eyebrow\\\">Get Started</span>\\n    <h2 id=\\\"prod-cta-heading\\\" class=\\\"sx-cta-final-title\\\">Ready to digitize your sub-metering?</h2>\\n    <p class=\\\"sx-cta-final-sub\\\">Request a quote for bulk deployment. Our team responds within 24 hours with site survey checklist and installation timeline.</p>\\n    <div class=\\\"sx-cta-final-actions\\\">\\n      <a class=\\\"sx-cta-final-btn sx-cta-final-btn--primary\\\" href=\\\"https://suriota.com/contact/\\\">Request Quote <span aria-hidden=\\\"true\\\">→</span></a>\\n      <a class=\\\"sx-cta-final-btn sx-cta-final-btn--wa\\\" href=\\\"https://wa.me/6285835672476?text=Hi%20SURIOTA%2C%20I%27m%20interested%20in%20PM1611-WD\\\" target=\\\"_blank\\\" rel=\\\"noopener\\\" aria-label=\\\"Chat on WhatsApp\\\">\\n        <svg width=\\\"16\\\" height=\\\"16\\\" viewBox=\\\"0 0 24 24\\\" fill=\\\"currentColor\\\" aria-hidden=\\\"true\\\"><path d=\\\"M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.893 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884-.001 2.225.651 3.891 1.746 5.634l-.999 3.648 3.742-.981zm11.387-5.464c-.074-.124-.272-.198-.57-.347-.297-.149-1.758-.868-2.031-.967-.272-.099-.47-.149-.669.149-.198.297-.768.967-.941 1.165-.173.198-.347.223-.644.074-.297-.149-1.255-.462-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.4